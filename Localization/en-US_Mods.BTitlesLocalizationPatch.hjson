ExtraTitles.Terraria.Aether: Aether

Logs: {
	// Debug
	BiomeColor: RGB({0},{1},{2})
	BiomeDetail: Scope={0} Icon={1} Source={2}
	BiomeEntry: Biome: Key={0} Title={1}
	// Errors
	CacheReadFailed: Failed to read config [{0}], keeping the last cached value: {1}
	CleanupRemoveCheckFuncFailed: Cleanup: failed to remove check func - {0}
	ConfigNull: BTitlesConfig is null, scan skipped
	CustomOverride: Custom override: {0} → {1}
	DefaultColorMarker: (default color)
	DetectionEx: Exception detecting {0}.{1}: {2}
	EnUsMapFailed: Failed to build en-US source map for mod [{0}]: {1}
	FormatError: Failed to format log template: template="{0}" error={1}
	HookDisposeFailed: Hook Dispose failed: {0}
	HookMethodMissing: BiomeTitlesUI.GetActualTitleName not found; the patch cannot work and refused to load
	IconLoadFailed: Failed to load icon for biome [{0}]: {1}
	// Icons
	IconNull: no
	IconPresent: yes ({0}x{1})
	// Features
	NativeTitleFailed: BTitles native title lookup failed for [{0}]: {1}
	NewBiome: New biome: [{0}] → {1}{2}
	RefreshFailed: Failed to refresh the current title: {0}
	RefreshUnavailable: Cannot refresh the current title (BTitles UI fields not found); new colors apply on the next biome change
	RescanOnFilterChanged: List settings changed, rescanning
	RescanOnOnlyFillMissing: Only fill missing changed, rescanning
	RestoredBiomes: Restored original titles for {0} existing biome(s)
	RestyledOff: Reset colors for {0} biomes
	RestyledOn: Restyled {0} biomes
	RetranslatedTitles: Language changed: retranslated {0} biome title(s)
	RetranslateFailed: Failed to retranslate biome titles: {0}
	SampleColorFailed: Failed to sample color from icon ({0}x{1}): {2}
	// Scan
	ScanApplyFailed: Failed to apply scan result: {0}
	ScanConfigNull: BTitlesConfig is null, scan toggle ON skipped
	ScanEnabled: Biome auto-scan enabled, starting scan...
	ScanFailed: Biome scan failed, registration could not complete; the patch refused to load
	ScanningMod: Scanning mod [{0}] with {1} ModBiomes
	ScanSummary: Scan done: {0} added ({5} pending color), {1} updated, {2} skipped | {3} entries, {4} checks
	ScanTargetMissing: BTitles scan target not found; the patch cannot work and refused to load
	ScanToggleOff: Scan disabled, unregistering registered biomes
	ScanToggleOn: Scan enabled, starting scan
	// Skipped
	SkippedByBlacklist: Skipped blacklisted biome: [{0}] → {1}
	SkippedByWhitelist: Skipped biome not in whitelist: [{0}] → {1}
	SkippedExistingBiome: Skipped existing biome: [{0}] → {1} (already in BTitles)
	SkippedPlaceholder: Skipped placeholder biome: [{0}] → {1} (no IsBiomeActive override)
	// Unload
	UnloadHopFailed: Main-thread hop failed during unload ({0}); biomes left in BTitles dictionary
	UnregisteredBiomes: Unregistered {0} biome(s) from the dictionary
}

SourceTags: {
	CustomName: Custom
	ModLocalization: Source Mod
	BTitles: Biome Titles
	ExtraTitles: Extra
	Fallback: Default
}

Configs: {
	BTitlesConfig: {
		DisplayName: Config

		Headers: {
			Scan: Scan
			Debug: Debug
			Styling: Styling
		}

		EnableScan: {
			Label: Scan for new biomes
			Tooltip: Scan for ModBiome in each module that were not included in the original module, and add them to the detection list
		}

		EnableAutoStyling: {
			Label: Color Scheme
			Tooltip:
				'''
				Assign title colors to the biomes the scan covers.
				Also the master switch for per-biome title colors: turning it off disables the whole color table.
				'''
		}

		EnableDebugLog: {
			Label: Debug logs
			Tooltip: Output the biome to client.log
		}

		PreferredColorSource: {
			Label: Color source
			Tooltip:
				'''
				Where the title color comes from.
				- BackgroundColor: use the color the biome declares for its bestiary background.
				- IconSampling: sample the representative color from the icon (the average of its valid pixels); biomes whose icon failed to load stay white;
				- Fixed: always use the fixed color below
				'''
		}

		FixedTitleColor: {
			Label: Fixed title color
			Tooltip: Used only when the color source is "Fixed"
		}

		OnlyFillMissingBiomes: {
			Label: Only biomes not added by "Biome Titles"
			Tooltip: When enabled, scanning never touches biomes already registered by "Biome Titles": no title overwrite, no styling, no snapshot
		}

		FilterMode: {
			Label: Biome blacklist/whitelist mode
			Tooltip:
				'''
				How the "List" below is used.
				- Disabled: the list is not used
				- Blacklist: biomes in the list are not scanned
				- Whitelist: only biomes in the list are scanned (an empty list scans everything)
				'''
		}

		ScanFilterList: {
			Label: List
			Tooltip:
				'''
				Read as a blacklist or a whitelist depending on "Biome blacklist/whitelist mode" above.
				Accepted forms: internal key (Mod.Biome), short biome name, or the title shown on screen;
				case and surrounding whitespace are ignored.
				'''
		}

		TitleColorMappings: {
			Label: Per-biome title colors
			Tooltip:
				'''
				Override the color source for specific biomes,
				matched against the title as it is displayed on screen.
				A match wins over the color source above
				'''
		}
	}

	BiomeColorMapping: {
		Title: {
			Label: Title text
			Tooltip: The biome title exactly as it appears on screen
		}

		Color: {
			Label: Title color
			Tooltip: Color used for this title
		}

		Tooltip: ""
	}

	BiomeFilterEntry: {
		Name: {
			Label: Biome
			Tooltip: Internal key (Mod.Biome), short biome name, or the title shown on screen
		}

		Tooltip: ""
	}

	ScanFilterMode: {
		Disabled: {
			Label: Disabled
			Tooltip: No list is used; all biomes are scanned
		}

		Blacklist: {
			Label: Blacklist
			Tooltip: Only biomes in the blacklist are skipped and no longer shown; the rest are scanned as usual
		}

		Whitelist: {
			Label: Whitelist
			Tooltip: Only biomes in the whitelist are scanned, the rest are skipped; an empty whitelist scans every biome
		}

		Tooltip: ""
	}

	TitleColorSource: {
		BackgroundColor: {
			Label: Background color
			Tooltip: Use only the biome's declared background color; pure white when absent
		}

		BackgroundColorSampling: {
			Label: Background first
			Tooltip: Prefer the biome's declared background color; fall back to icon sampling when it is missing or white
		}

		IconSampling: {
			Label: Icon sampling
			Tooltip: Always sample the representative color from the biome icon
		}

		Fixed: {
			Label: Fixed color
			Tooltip: Always use the fixed color chosen below
		}

		Tooltip: ""
	}
}
