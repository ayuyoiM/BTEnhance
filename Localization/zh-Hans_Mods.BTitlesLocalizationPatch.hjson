ExtraTitles.Terraria.Aether: 以太

Logs: {
	ScanEnabled: 已启用扫描新群系，开始扫描……
	BiomeEntry: 群系：Key={0} 标题={1}
	BiomeDetail: 源={0} 图标={1} 翻译来源={2}
	IconPresent: 有（{0}x{1}）
	IconNull: 无
	CustomOverride: 自定义覆盖：{0} → {1}
	ConfigNull: 未获取到配置实例，扫描已跳过
	DetectionEx: 检测 [{0}] 模组的 [{1}] 群系时出错: {2}
	BiomeColor: RGB（{0},{1},{2}）
	IconLoadFailed: 加载群系 [{0}] 的图标时失败: {1}
	NewBiome: 新增群系: [{0}] → {1}{2}
	DefaultColorMarker: （未配色）
	ScanningMod: 正在扫描模组 [{0}]，发现 {1} 个模组群系
	SkippedPlaceholder: 跳过占位群系: [{0}] → {1}（未重写检测方法）
	ScanSummary: 扫描完毕：{0} 新增（{5} 个群系未配色），{1} 更新，{2} 跳过 | 字典 {3} 项，检测 {4} 个
	ScanToggleOn: 已启用扫描，开始扫描……
	ScanToggleOff: 已禁用扫描，卸载已注册的群系……
	RestyledOn: 已配色 {0} 个群系
	RestyledOff: 已重置 {0} 个群系的颜色
	UnregisteredBiomes: 已从字典卸载 {0} 个群系
	RestoredBiomes: 已还原 {0} 个已有群系的原标题
	FormatError: 格式化日志模板失败：模板="{0}" 错误={1}
	CacheReadFailed: 读取配置 [{0}] 失败，沿用上一次缓存值：{1}
	SampleColorFailed: 从图标 （{0}x{1}） 采样代表性颜色失败：{2}
	NativeTitleFailed: BTitles 原生标题解析失败：群系 [{0}]，错误={1}
	ScanConfigNull: 未获取到配置实例，扫描启用操作已跳过
	HookMethodMissing: 找不到 BTitles 的 BiomeTitlesUI.GetActualTitleName 方法，补丁无法工作，已拒绝加载
	ScanTargetMissing: 找不到 BTitles 的扫描目标，补丁无法工作，已拒绝加载
	ScanFailed: 扫描群系时出错，补丁无法完成注册，已拒绝加载
	ScanApplyFailed: 提交扫描结果时出错：{0}
	UnloadHopFailed: 卸载期间主线程跳转失败（{0}），BTitles 字典中的群系条目未能移除
	EnUsMapFailed: 构建模组 [{0}] 的 en-US 源文案表失败：{1}
	SkippedExistingBiome: 已跳过已有群系: [{0}] → {1}（BTitles 已收录）
	RescanOnOnlyFillMissing: 「仅补漏群系」已变更，正在先撤再扫……
	RefreshUnavailable: 无法即时刷新当前标题（未取到 BTitles 的界面字段），新配色将在下次切换群系时生效
	RefreshFailed: 刷新当前标题失败：{0}
	HookDisposeFailed: 卸载 Hook 失败：{0}
	CleanupRemoveCheckFuncFailed: 清理：移除检测函数失败 - {0}
}

SourceTags: {
	CustomName: 自定义
	ModLocalization: 源模组
	BTitles: BTitles
	ExtraTitles: 补充翻译
	Fallback: 默认
}

Configs: {
	BTitlesConfig: {
		DisplayName: 配置

		Headers: {
			Scan: 扫描
			Debug: 调试
			Styling: 配色
		}

		EnableScan: {
			Label: 扫描新群系
			Tooltip: 扫描各模组中未被原模组收录的模组群系（ModBiome）并添加到检测列表
		}

		EnableAutoStyling: {
			Label: 配色
			Tooltip:
				'''
				为扫描涉及的群系自动设置标题颜色。
				同时是逐群系配色表的总开关：关掉后整张表一并失效。
				'''
		}

		EnableDebugLog: {
			Label: 调试日志
			Tooltip: 输出调试日志到控制台
		}

		PreferredColorSource: {
			Label: 颜色来源
			Tooltip:
				'''
				标题颜色的来源。
				- 背景色：用群系为图鉴背景声明的颜色，没声明时从图标采样。
				- 图标采样：从图标采代表性颜色（有效像素的平均色）；图标加载失败的群系保持白色；
				- 固定颜色：总是用下方选定的固定颜色
				'''
		}

		FixedTitleColor: {
			Label: 固定标题颜色
			Tooltip: 仅在颜色来源为「固定颜色」时生效
		}

		OnlyFillMissingBiomes: {
			Label: 仅补漏群系
			Tooltip: 开启后，扫描不再触碰 BTitles 已注册的群系：不覆写标题、不配色、不做快照
		}

		TitleColorMappings: {
			Label: 逐群系标题颜色
			Tooltip:
				'''
				为指定群系覆盖颜色来源，
				按屏幕上实际显示的标题名匹配，
				命中优先于上方「颜色来源」
				'''
		}
	}

	BiomeColorMapping: {
		Title: {
			Label: 标题文字
			Tooltip:
				'''
				屏幕上实际显示的群系标题
				（当前语言下的样子）
				'''
		}

		Color: {
			Label: 标题颜色
			Tooltip: 该标题使用的颜色
		}

		// Tooltip: ""
	}

	TitleColorSource: {
		BackgroundColor: {
			Label: 背景色
			Tooltip: 优先使用群系声明的背景色
		}

		IconSampling: {
			Label: 图标采样
			Tooltip: 总是从群系图标采样代表性颜色
		}

		Fixed: {
			Label: 固定颜色
			Tooltip: 总是使用下方选定的固定颜色
		}

		// Tooltip: ""
	}
}
