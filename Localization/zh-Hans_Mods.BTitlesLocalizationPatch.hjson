ExtraTitles.Terraria.Aether: 以太

Logs: {
	ScanEnabled: 已启用扫描新群系，开始扫描……
	BiomeEntry: 群系：Key={0} 标题={1}
	BiomeDetail: 源={0} 图标={1} 翻译来源={2}
	IconPresent: 有（{0}x{1}）
	IconNull: 无
	CustomOverride: 自定义覆盖：{0} → {1}
	ConfigNull: 未获取到配置实例，扫描已跳过
	DetectionEx: 检测 [{0}] 模组的 [{1}] 群系时出错: {2}
	BiomeColor: RGB（{0},{1},{2}）
	IconLoadFailed: 加载群系 [{0}] 的图标时失败: {1}
	NewBiome: 新增群系: [{0}] → {1}{2}
	DefaultColorMarker: （未配色）
	ScanningMod: 正在扫描模组 [{0}]，发现 {1} 个模组群系
	SkippedPlaceholder: 跳过占位群系: [{0}] → {1}（未重写检测方法）
	ScanSummary: 扫描完毕：{0} 新增（{5} 个群系未配色），{1} 更新，{2} 跳过 | 字典 {3} 项，检测 {4} 个
	ScanToggleOn: 已启用扫描，开始扫描……
	ScanToggleOff: 已禁用扫描，卸载已注册的群系……
	RestyledOn: 已配色 {0} 个群系
	RestyledOff: 已重置 {0} 个群系的颜色
	UnregisteredBiomes: 已从字典卸载 {0} 个群系
	RestoredBiomes: 已还原 {0} 个已有群系的原标题
	FormatError: 格式化日志模板失败：模板="{0}" 错误={1}
	SampleColorFailed: 从图标 （{0}x{1}） 采样主色失败：{2}
	NativeTitleFailed: BTitles 原生标题解析失败：群系 [{0}]，错误={1}
	ScanConfigNull: 未获取到配置实例，扫描启用操作已跳过
	HookMethodMissing: 找不到 BTitles 的 BiomeTitlesUI.GetActualTitleName 方法，补丁无法工作，已拒绝加载
	ScanTargetMissing: 找不到 BTitles 的扫描目标，补丁无法工作，已拒绝加载
	ScanFailed: 扫描群系时出错，补丁无法完成注册，已拒绝加载
	ScanApplyFailed: 提交扫描结果时出错：{0}
}

SourceTags: {
	CustomName: 自定义
	ModLocalization: 源模组
	BTitles: BTitles
	ExtraTitles: 补充翻译
	Fallback: 默认
}

Configs: {
	BTitlesConfig: {
		DisplayName: 配置

		Headers: {
			Scan: 扫描
			Debug: 调试
		}

		EnableScan: {
			Label: 扫描新群系
			Tooltip: 扫描各模组中未被原模组收录的模组群系（ModBiome）并添加到检测列表
		}

		EnableAutoStyling: {
			Label: 配色
			Tooltip: 为新增的群系分配标题颜色
		}

		EnableDebugLog: {
			Label: 调试日志
			Tooltip: 输出调试日志到控制台
		}
	}
}
